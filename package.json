{
  "name": "pixeltwin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/pixeltwin/pixeltwin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixeltwin/pixeltwin.git"
  },
  "bugs": "https://github.com/pixeltwin/pixeltwin/issues",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "openapi": "bun run scripts/openapi.ts",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "examples": "bun scripts/examples.ts",
    "screenshots": "UPDATE_SCREENSHOTS=1 playwright test -c e2e/playwright.config.ts screenshots",
    "site:images": "bun scripts/site-images.ts",
    "site:check": "bun scripts/site-check.ts"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/api-reference": "^1.74.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "^4.0.33"
  }
}
