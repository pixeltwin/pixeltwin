{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "paths": {
      "@pixeltwin/client": ["./packages/client/src/index.ts"],
      "@pixeltwin/client/run": ["./packages/client/src/run.ts"],
      "@pixeltwin/playwright": ["./packages/playwright/src/index.ts"],
      "@pixeltwin/playwright/config": ["./packages/playwright/src/config.ts"],
      "@pixeltwin/wdio": ["./packages/wdio/src/index.ts"]
    }
  },
  "include": ["src", "test", "scripts", "e2e", "packages/*/src", "packages/*/test"]
}
